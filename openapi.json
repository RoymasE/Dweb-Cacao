{"openapi":"3.0.1","info":{"title":"API Intranet Agroindustrial - Cacao Premium del Perú S.A.C.","description":"Backend REST API para la gestión de producción de cacao fino de aroma: acopio en baba, trazabilidad de fermentación, control de secado, pesaje por secciones (granos y polvo), balance integral de masas, pedidos de exportación y packing list marítimo.","contact":{"name":"Equipo de Desarrollo - Cacao Premium","email":"contacto@cacaopremium.pe"},"license":{"name":"Apache 2.0","url":"https://springdoc.org"},"version":"1.0.0"},"servers":[{"url":"http://localhost:8080","description":"Generated server url"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"7. Recepción de Cosecha y Lotes de Cacao (RF-06)","description":"Registro de cacao en baba ingresado y apertura de lotes de trazabilidad"},{"name":"4. Gestión de Proveedores de Acopio (RF-04)","description":"Registro de agricultores asociados, parcelas de origen y contratos comunales"},{"name":"1. Autenticación y Control de Acceso (RF-01)","description":"Endpoints de login seguro con BCrypt y token JWT"},{"name":"12. Control de Despacho y Lista de Empaque (RF-13)","description":"Generación del Packing List oficial de sacos y lotes para exportación marítima"},{"name":"9. Control de Secado y Medición de Humedad (RF-08)","description":"Monitoreo del tendido en secadores solares hasta alcanzar ~7% de humedad"},{"name":"6. Catálogo de Cajones de Madera (RF-06)","description":"Control de cajas de madera para fermentación de cacao"},{"name":"11. Gestión de Pedidos y Ventas Internacionales (RF-12)","description":"Recepción de solicitudes de clientes extranjeros, reserva por sección y confirmación comercial con restricción de stock"},{"name":"2. Gestión de Usuarios y Roles (RF-02)","description":"Administración de cuentas internas de planta y privilegios"},{"name":"8. Monitoreo Técnico de Fermentación (RF-07)","description":"Control diario en cajones (4-6 días), control de volteos, temperatura en °C y alertas semafóricas 